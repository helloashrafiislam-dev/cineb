# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ----------------------------------------------------
# TMDB (The Movie Database) — backend only
# Get credentials at https://www.themoviedb.org/settings/api
# Never put these values in frontend code / VITE_* vars.
# Prefer TMDB_ACCESS_TOKEN (API Read Access Token / v4 JWT).
# TMDB_API_KEY (v3) is used as a fallback if the access token is empty.
#
# Production (Vercel / host dashboard): set the SAME three names as secrets.
# After changing them, redeploy so the Node server picks up the new env.
# This app is a long-running Express server (not serverless functions) —
# ensure your host runs `npm start` with these vars available to the process.
# ----------------------------------------------------
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/

# ----------------------------------------------------
# NexStream (authorized embed streaming) — backend only
# Documented usage:
#   https://api.codespecters.com/embed/movie/{tmdbId}?apikey=YOUR_KEY
# Sources are resolved by TMDB id (no documented title-search API).
# Never put these values in frontend code / VITE_* vars.
# ----------------------------------------------------
NEXSTREAM_API_KEY=
NEXSTREAM_API_BASE_URL=https://api.codespecters.com

# ----------------------------------------------------
# Vidsrc (authorized public embed fallback) — backend only
# Documented usage (https://vidsrc.mov/):
#   Movie:  /embed/movie/{imdbOrTmdbId}
#   TV:     /embed/tv/{id}/{season}/{episode}
#   Feeds:  /vapi/movie/new , /vapi/movie/add
# Prefer IMDb id when available; otherwise TMDB id.
# No API key required. Set VIDSRC_ENABLED=false to disable.
# ----------------------------------------------------
VIDSRC_ENABLED=true
VIDSRC_BASE_URL=https://vidsrc.mov

# Optional server settings
# PORT=3000
# JWT_SECRET=cinestream-secure-token-secret-key-2026
# NODE_ENV=development

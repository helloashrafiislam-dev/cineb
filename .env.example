# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ----------------------------------------------------
# TMDB (The Movie Database) — backend only
# Get credentials at https://www.themoviedb.org/settings/api
# Never put these values in frontend code / VITE_* vars.
# Prefer TMDB_ACCESS_TOKEN (API Read Access Token / v4 JWT).
# TMDB_API_KEY (v3) is used as a fallback if the access token is empty.
#
# Production (Vercel Project → Settings → Environment Variables):
# set the SAME names below, then Redeploy.
# On Vercel, `npm run build` bundles Express into api/index.js (serverless)
# and serves the Vite frontend from dist/. Local still uses `npm run dev`.
# ----------------------------------------------------
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/

# ----------------------------------------------------
# NexStream (third-party embed) — backend only
# Documented usage:
#   https://api.codespecters.com/embed/movie/{tmdbId}?apikey=YOUR_KEY
# Sources are resolved by TMDB id (no documented title-search API).
# A working embed is NOT a commercial license. Mark Verified only in
# Admin → Content Compliance after you obtain authorization evidence.
# Never put these values in frontend code / VITE_* vars.
# ----------------------------------------------------
NEXSTREAM_API_KEY=
NEXSTREAM_API_BASE_URL=https://api.codespecters.com

# ----------------------------------------------------
# Vidsrc (third-party public embed) — backend only
# Documented usage (https://vidsrc.mov/):
#   Movie:  /embed/movie/{imdbOrTmdbId}
#   TV:     /embed/tv/{id}/{season}/{episode}
#   Feeds:  /vapi/movie/new , /vapi/movie/add
# Prefer IMDb id when available; otherwise TMDB id.
# Public embeds ≠ AdSense-safe authorization. Defaults to Unverified.
# No API key required. Set VIDSRC_ENABLED=false to disable.
# ----------------------------------------------------
# Safer default for AdSense / copyright posture — enable only after legal review
VIDSRC_ENABLED=false
VIDSRC_BASE_URL=https://vidsrc.mov

# ----------------------------------------------------
# Site legal / contact (shown on About, Contact, Privacy, DMCA)
# Replace placeholders before AdSense review.
# ----------------------------------------------------
SITE_NAME=CineStream
SITE_LEGAL_NAME=CineStream
CONTACT_EMAIL=contact@example.com
DMCA_EMAIL=dmca@example.com
# APP_URL / SITE_PUBLIC_URL used for absolute sitemap links when set
# SITE_PUBLIC_URL=https://your-domain.com

# Optional server settings
# PORT=3000
# JWT_SECRET=cinestream-secure-token-secret-key-2026
# NODE_ENV=development
